# Copy to .env for local development. Never commit .env.
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# MySQL from docker-compose.yml (host port 3307)
DATABASE_URL=mysql://phimhay:phimhay@127.0.0.1:3307/phimhay
# Redis cache: off in development (no caching). Set it in production.
# To test Redis locally: docker compose --profile redis up -d, then uncomment:
# REDIS_URL=redis://127.0.0.1:6380/0
BRAND_NAME=PhimHay
